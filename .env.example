# Bildirimlerin (transaction/balance) gönderildiği backend API
# Eski sabit host bu değişkene taşındı.
API_BASE_URL=http://localhost:3000

# REST API portu
PORT=3999

# Log dizini (varsayılan: proje içindeki ./logs)
LOG_DIR=./logs

# --- Ethereum node ---
ETH_RPC_URL=http://localhost:8547
ETH_WS_URL=ws://localhost:8547
# personal_* çağrılarında kullanılan hesap parolası
ETH_ACCOUNT_PASSWORD=
# Bakiyelerin toplandığı ana hesap adresi
ETH_MAIN_ACCOUNT=
# addpeer endpoint'inin eklediği enode
ETH_PEER_ENODE=
ETHERSCAN_API_KEY=

# --- Bitcoin / Litecoin ---
BTC_RPC_USERNAME=
BTC_RPC_PASSWORD=
BTC_RPC_PORT=8332
BTC_INSIGHT_URL=https://insight.bitpay.com
LTC_INSIGHT_URL=https://insight.litecore.io

# --- Ripple (XRP) ---
XRP_SERVER=wss://s2.ripple.com:443
XRP_ADDRESS=
# Cüzdan secret'ı (family seed). Asla repoya commit etme.
XRP_SECRET=
